---
layout: null
---
{
  "guides": [
    {% for guide in site.guides %}
    {
      "slug": "{{ guide.slug }}",
      "title": "{{ guide.short_title | default: guide.title | escape }}",
      "fullTitle": "{{ guide.title | escape }}",
      "description": "{{ guide.description | escape }}",
      "category": "{{ guide.category }}",
      "webURL": "{{ site.url }}{{ guide.url }}",
      "lastUpdated": "{{ guide.last_updated | date_to_xmlschema }}"
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "lastUpdated": "{{ site.time | date_to_xmlschema }}"
}
